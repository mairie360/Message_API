# Semgrep ignores every file matching these patterns.
# Defining this file replaces Semgrep's built-in defaults, so they are repeated below.
:include .gitignore

# Semgrep defaults
.git/
node_modules/
vendor/
test/
tests/
*_test.*
*.min.js
*.min.css

